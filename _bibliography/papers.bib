@article{huang2025impact,
  abbr          = {IJME},
  bibtex_show   = {true},
  selected      = {true},
  title         = {The impact of simulation-based emergency training on novice critical care nurses: a quasi-experimental study},
  author        = {Huang, Yi-Chen and Lin, Huang and Yao, Ting-Yu and Lee, Tsung-Han and Chiang, Tsay-I and Lin, Chih-Hao},
  journal       = {International Journal of Medical Education},
  volume        = {16},
  pages         = {138--144},
  year          = {2025},
  publisher     = {IJME},
  doi           = {10.5116/ijme.68a2.dc6f},
  html          = {https://doi.org/10.5116/ijme.68a2.dc6f},
  dimensions    = {true},
  abstract      = {This quasi-experimental study evaluated the impact of simulation-based emergency training on novice critical care nurses' knowledge, skills, and confidence compared to traditional clinical teaching, aiming to enhance their preparedness for high-pressure emergency scenarios. A pretest-posttest non-equivalent control group design was conducted in a Taiwan medical center's critical care unit from October 2023 to January 2024. Sixty-seven nurses with less than two years of experience were assigned to an experimental group (n=32, simulation-based training) or a control group (n=35, traditional teaching). The experimental group underwent an OSCE-based intervention with three stations. The simulation group showed significant improvements in skills and confidence, while the traditional group improved in confidence only. No significant between-group differences were found in overall outcomes. Simulation-based training effectively enhances skills and confidence in novice critical care nurses, complementing traditional methods. Integrating both approaches can optimize training outcomes, improving patient safety and nurse retention in medical education.},
}

@article{lee2025effectiveness,
  abbr          = {NEP},
  bibtex_show   = {true},
  selected      = {true},
  title         = {Effectiveness of virtual reality-based training in clinical skills for newly graduated nurses},
  author        = {Lee, Ya-Wen and Chen, Shu-Jyuan and Huang, Wan-Ru and Ku, Hui-Hsin and Chang, Ai-Ling and Lin, Chih-Hao},
  journal       = {Nurse Education in Practice},
  volume        = {88},
  pages         = {104587},
  year          = {2025},
  publisher     = {Churchill Livingstone},
  doi           = {10.1016/j.nepr.2025.104587},
  html          = {https://doi.org/10.1016/j.nepr.2025.104587},
  dimensions    = {true},
  abstract      = {This study compares the impact of virtual reality (VR) training versus conventional e-learning on newly graduated nurses (NGNs) learning six core clinical skills. Self-efficacy was primarily assessed, along with secondary outcomes including knowledge, skills, and satisfaction, while also identifying factors that influence self-efficacy. A quasi-experimental pre-test/post-test design with a comparison group and three-month follow-up was used. A total of 150 NGNs at a Taiwanese medical center were assigned to VR (n=75) or e-learning (n=75) groups via alternating cohorts. Both received physical skills training post-online modules. Outcomes were assessed at baseline (T1), post-physical training (T2), and three months (T3). No significant Time-by-Group interactions were found for self-efficacy, cognitive knowledge, clinical skills, or satisfaction, showing VR was not superior. Significant Time effects indicated T1-to-T2 gains, with declines at T3 for self-efficacy and cognition. Baseline self-efficacy and T3 satisfaction predicted T3 self-efficacy. VR training did not outperform e-learning over three months. Both supported short-term gains, but sustaining these requires further strategies.},
}


