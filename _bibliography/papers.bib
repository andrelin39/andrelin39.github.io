@article{li2012dynamic,
  abbr          = {JBR},
  bibtex_show   = {true},
  title         = {Dynamic pricing in regulated automobile insurance markets with heterogeneous insurers: Strategies nice versus nasty for customers},
  author        = {Li, Chu-Shiu and Lin, Chih-Hao and Liu, Chwen-Chi and Woodside, Arch G.},
  journal       = {Journal of Business Research},
  volume        = {65},
  number        = {7},
  pages         = {968--976},
  year          = {2012},
  publisher     = {Elsevier},
  doi           = {10.1016/j.jbusres.2011.04.015},
  html          = {https://doi.org/10.1016/j.jbusres.2011.04.015},
  dimensions    = {true},
  abstract      = {This study examines a phenomenon in one nation's automobile insurance market where insurers adopt diverse pricing strategies in this regulated industry that does not allow for such diversions---a homogeneous, insurance industry in which a government authority sets the official pricing formula as well as all of the rating factors. Insurers use a claim coefficient that reflects previous claim records of policyholders as an implicit pricing tool to over/under charge new and repeat customers. The results show that firm-level, systematic price variances occur that differ from prices following regulated individual-claim coefficients. Based on the unique firm-level pricing strategies, this study finds that some insurers are more nice to new customers and nasty to repeat customers to increase market shares while other insurers earn high profits by being nasty to repeat customers. The assumption that a behavioral primacy effect may exist in the market may guide some firms' pricing strategies.},
}


