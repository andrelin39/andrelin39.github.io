@article{lee2026psychometric,
  abbr          = {RNH},
  bibtex_show   = {true},
  selected      = {true},
  title         = {Psychometric Properties of the Traditional Chinese Version of the Interprofessional Collaborative Competency Attainment Survey},
  author        = {Lee, Ya-Wen and Chiang, Chih-Lung and Wen, Yung-Sung and Huang, Chin-Yi and Li, Hsin-Tzu and Lin, Chih-Hao},
  journal       = {Research in Nursing \& Health},
  volume        = {49},
  number        = {1},
  pages         = {87--96},
  year          = {2026},
  doi           = {10.1002/nur.70037},
  html          = {https://doi.org/10.1002/nur.70037},
  dimensions    = {true},
  abstract      = {This study developed and validated the Traditional Chinese version of the Interprofessional Collaborative Competency Attainment Survey (TC-ICCAS) for evaluating interprofessional education (IPE) competencies in Taiwan's healthcare system. The research involved 324 early-career healthcare professionals across three phases: translation with cultural adaptation, pilot testing, and field testing after IPE programs. Confirmatory factor analysis confirmed the instrument's six-domain structure: communication, collaboration, roles and responsibilities, patient-centered care, conflict management, and team functioning. All subscales showed strong internal consistency (Cronbach's alpha = 0.86--0.93). The TC-ICCAS provides a culturally appropriate tool for assessing interprofessional education outcomes in hierarchical healthcare settings, potentially improving teamwork and patient safety in Taiwan and similar Asian contexts.},
}

@article{tsai2026sustaining,
  abbr          = {CSN},
  bibtex_show   = {true},
  selected      = {true},
  title         = {Sustaining emergency team competencies: Impact of interprofessional simulation with team resource management and structured debriefing},
  author        = {Tsai, Yi-Hsuan and Chiu, Chun-Wen and Sun, Shou-Chuan and Lin, Hsing-Ju and Lin, Chih-Hao and Lee, Ya-Wen},
  journal       = {Clinical Simulation in Nursing},
  volume        = {110},
  pages         = {101880},
  year          = {2026},
  publisher     = {Elsevier},
  doi           = {10.1016/j.ecns.2025.101880},
  html          = {https://doi.org/10.1016/j.ecns.2025.101880},
  dimensions    = {true},
  abstract      = {Effective interprofessional collaboration is essential for patient safety in emergency care. While high-fidelity simulation (HFS) enhances training, its long-term impact on Team Resource Management (TRM) behaviors and communication remains uncertain. A quasi-experimental study at a Taiwanese tertiary medical center evaluated an HFS program integrating TRM principles and Gather-Analyze-Summarize (GAS) debriefing. Assessments at pretraining (T0), post-training (T1), and three months post-training (T2) measured individual knowledge and skills, plus team-level TRM behaviors and communication. Individual knowledge and skills improved significantly at T1, with nurses demonstrating substantial gains. Team-level TRM behaviors and communication increased from T0 to T1 and remained sustained at T2. GAS debriefing with TRM principles promotes sustained team competencies for at least three months, supporting the need for periodic retraining to maintain skill retention.},
}

@article{ya2026using,
  abbr          = {JNR},
  bibtex_show   = {true},
  selected      = {true},
  title         = {Using the Objective Structured Teaching Examination to Improve the Clinical Teaching Efficacy of Clinical Preceptors: A Quasi-Experimental Study},
  author        = {Lee, Ya-Wen and Huang, Wan-Ru and Chao, Tsen-En and Wen, Yung-Sung and Chang, Yu-Jun and Lin, Chih-Hao},
  journal       = {Journal of Nursing Research},
  volume        = {34},
  number        = {1},
  pages         = {e436},
  year          = {2026},
  publisher     = {LWW},
  doi           = {10.1097/jnr.0000000000000726},
  html          = {https://doi.org/10.1097/jnr.0000000000000726},
  dimensions    = {true},
  abstract      = {Clinical preceptors are vital to the retention of new nurses, though evaluations of teaching behavior changes post-training remain scarce. The Objective Structured Teaching Examination (OSTE) is an underutilized tool for assessing instructional skills. This quasi-experimental study evaluated whether OSTE improves clinical preceptor teaching competencies, with follow-up assessments at 3 and 6 months. A quasi-experimental design involved 122 clinical preceptors at a Taiwanese medical center (experimental group: 63; control: 59). The experimental group completed seven OSTE sessions. Teaching competencies were measured using the Clinical Teaching Behavior Inventory at baseline, immediately post-intervention, and at 3 and 6 months. The experimental group demonstrated significant improvements across all domains immediately after intervention, with gains sustained at 3 months and 6 months post-OSTE. Control group improvements were inconsistent and not significant until 6 months. OSTE effectively enhances teaching competencies short-term, with effects declining but remaining significant through 6 months. Sustained improvement requires ongoing training and integrated assessment tools.},
}


