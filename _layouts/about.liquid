---
layout: default
---
<div class="post home-page">
  <div class="about-top">
    <div class="about-top-text">
      <header class="post-header">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            {% if site.name_zh %}
              <span class="lang-zh"
                ><span class="name-main">{{ site.name_zh }}</span
                ><span class="name-secondary">
                  {{- site.first_name -}}
                  {%- if site.middle_name %} {{ site.middle_name }}{% endif %}
                  {{ site.last_name -}}
                </span></span
              >
              <span class="lang-en"
                ><span class="name-main">
                  {{- site.first_name -}}
                  {%- if site.middle_name %} {{ site.middle_name }}{% endif %}
                  {{ site.last_name -}}</span
                ><span class="name-secondary">{{ site.name_zh }}</span></span
              >
            {% else %}
              <span class="font-weight-bold">{{ site.first_name }}</span>
              {%- if site.middle_name %} {{ site.middle_name }}{% endif %}
              {{ site.last_name }}
            {% endif %}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <p class="desc">
          <span class="lang-zh">{{ page.subtitle }}</span>
          {% if page.subtitle_en -%}
            <span class="lang-en">{{ page.subtitle_en }}</span>
          {%- endif %}
        </p>
      </header>
      <div class="about-body">{{ content }}</div>
    </div>
    {% if page.profile and page.profile.image %}
      <div class="about-top-photo">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% if page.profile.image_circular %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
        {% else %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
        {% endif %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class=profile_image_class alt=page.profile.image
          cache_bust=true
        %}
      </div>
    {% endif %}
  </div>

  <!-- Latest posts -->
  {% if page.latest_posts and page.latest_posts.enabled %}
    <div class="about-section-block">
      <h2 class="about-section-heading">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit; text-decoration: none;">
          <span class="lang-zh">近期文章</span>
          <span class="lang-en">Latest Posts</span>
        </a>
      </h2>
    </div>
    {% include latest_posts.liquid %}
  {% endif %}

  <!-- Selected papers -->
  {% if page.selected_papers %}
    <div class="about-section-block">
      <h2 class="about-section-heading">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit; text-decoration: none;">
          <span class="lang-zh">精選論文</span>
          <span class="lang-en">Selected Publications</span>
        </a>
      </h2>
    </div>
    {% include selected_papers.liquid %}
  {% endif %}

  <!-- Social -->
  {% if page.social %}
    <div class="social about-social">
      <div class="contact-icons">{% social_links %}</div>
      <div class="contact-note">{{ site.contact_note }}</div>
    </div>
  {% endif %}

  <!-- Visitor stats -->
  <div class="visitor-stats" style="text-align: center; font-size: 0.8rem; color: #9CA3AF; margin-top: 1rem;">
    <span class="lang-zh">總瀏覽次數</span>
    <span class="lang-en">Total Views</span>
    <span id="busuanzi_container_site_pv">
      <span id="busuanzi_value_site_pv"></span>
    </span>
    ·
    <span class="lang-zh">訪客人數</span>
    <span class="lang-en">Visitors</span>
    <span id="busuanzi_container_site_uv">
      <span id="busuanzi_value_site_uv"></span>
    </span>
  </div>

  {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
    {% include newsletter.liquid center=true %}
  {% endif %}

  <!-- Comments -->
  {% if site.giscus and page.giscus_comments %}
    <div class="about-section-block">
      <h2 class="about-section-heading">
        <span class="lang-zh">留言板</span>
        <span class="lang-en">Comments</span>
      </h2>
    </div>
    {% include giscus.liquid %}
  {% endif %}
</div>
