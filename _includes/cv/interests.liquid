{% comment %}
  Unified interests entry renderer for both formats
  Bilingual: renders *_en fields when available, controlled by data-lang on <html>
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="interest-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      <strong>
        <span class="lang-zh">{{ entry.name }}</span>
        <span class="lang-en">{{ entry.name_en | default: entry.name }}</span>:
      </strong>
      {% if entry.keywords %}
        <span class="lang-zh">{{ entry.keywords }}</span>
        <span class="lang-en">{{ entry.keywords_en | default: entry.keywords }}</span>
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
  .interest-item {
    padding: 0.5rem 0;
  }
</style>
