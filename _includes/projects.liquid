<div class="col">
  <div class="card h-100 hoverable">
    <div class="card-body">
      <h2 class="card-title">
        {% if project.title_en %}
          <span class="lang-zh">{{ project.title }}</span>
          <span class="lang-en">{{ project.title_en }}</span>
        {% else %}
          {{ project.title }}
        {% endif %}
      </h2>
      <p class="card-text">
        {% if project.description_en %}
          <span class="lang-zh">{{ project.description }}</span>
          <span class="lang-en">{{ project.description_en }}</span>
        {% else %}
          {{ project.description }}
        {% endif %}
      </p>
    </div>
    <div class="card-footer bg-transparent border-top-0 d-flex gap-2 pb-3">
      {% if project.github %}
        <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark">
          <i class="fa-brands fa-github"></i>&nbsp;GitHub
        </a>
      {% endif %}
      <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="btn btn-sm btn-outline-primary">
        <span class="lang-zh">詳細說明</span>
        <span class="lang-en">Details</span>
      </a>
    </div>
  </div>
</div>
